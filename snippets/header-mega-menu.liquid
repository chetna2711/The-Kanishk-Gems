{% comment %}
  Renders a megamenu for the header.

  Usage:
  {% render 'header-mega-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- if section.settings.enable_browse_categories -%}
      <li class="header__browse-categories-wrapper">
        {%- if section.settings.browse_categories_menu != blank and section.settings.browse_categories_menu.links.size > 0 -%}
          <header-menu>
            <details id="Details-HeaderMenu-BrowseCategories" class="mega-menu">
              <summary
                id="HeaderMenu-BrowseCategories"
                class="header__browse-categories-btn header__browse-categories-btn--{{ section.settings.browse_categories_style | default: 'theme_header' }}"
              >
                <span class="header__browse-categories-icon">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                  </svg>
                </span>
                <span>{{ section.settings.browse_categories_label | default: 'Browse Categories' }}</span>
                <span class="header__browse-categories-caret">
                  <svg width="9" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1 1L5 5L9 1"/>
                  </svg>
                </span>
              </summary>
              <div
                id="MegaMenu-Content-BrowseCategories"
                class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce"
                tabindex="-1"
              >
                {%- liquid
                  assign browse_has_sublinks = false
                  for cat_link in section.settings.browse_categories_menu.links
                    if cat_link.links != blank
                      assign browse_has_sublinks = true
                      break
                    endif
                  endfor
                -%}
                <ul class="mega-menu__list page-width{% if browse_has_sublinks %} mega-menu__list--with-sublinks{% else %} mega-menu__list--inline-row{% endif %}" role="list">
                  {%- for cat_link in section.settings.browse_categories_menu.links -%}
                    <li class="{% if browse_has_sublinks %}mega-menu__column{% else %}mega-menu__inline-item{% endif %}">
                      <a href="{{ cat_link.url }}" class="{% if browse_has_sublinks %}mega-menu__link mega-menu__link--level-2 link{% else %}mega-menu__pill-link link{% endif %}">
                        {{ cat_link.title | escape }}
                      </a>
                      {%- if cat_link.links != blank -%}
                        <ul class="list-unstyled mega-menu__sublist" role="list">
                          {%- for sub_cat_link in cat_link.links -%}
                            <li>
                              <a href="{{ sub_cat_link.url }}" class="mega-menu__link link">
                                {{ sub_cat_link.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            href="{{ section.settings.browse_categories_link | default: routes.collections_url }}"
            class="header__browse-categories-btn header__browse-categories-btn--{{ section.settings.browse_categories_style | default: 'theme_header' }}"
          >
            <span class="header__browse-categories-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </span>
            <span>{{ section.settings.browse_categories_label | default: 'Browse Categories' }}</span>
            <span class="header__browse-categories-caret">
              <svg width="9" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M1 1L5 5L9 1"/>
              </svg>
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endif -%}
    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce"
                tabindex="-1"
              >
                {%- liquid
                  assign current_link_title = link.title | downcase | strip
                  assign matching_promo = null
                  for block in section.blocks
                    if block.type == 'mega_menu_promo'
                      assign target_title = block.settings.menu_item_title | downcase | strip
                      if target_title != blank and target_title == current_link_title
                        assign matching_promo = block
                        break
                      endif
                    endif
                  endfor

                  assign has_sublinks = false
                  for childlink in link.links
                    if childlink.links != blank
                      assign has_sublinks = true
                      break
                    endif
                  endfor
                -%}
                <div class="mega-menu__inner page-width{% if matching_promo %} mega-menu__inner--with-promo{% endif %}" style="{% if matching_promo %}--promo-card-width: {{ matching_promo.settings.card_width | default: '32rem' }};{% endif %}">
                  <ul
                    class="mega-menu__list{% if has_sublinks %} mega-menu__list--with-sublinks{% else %} mega-menu__list--inline-row{% endif %}{% if link.levels == 1 %} mega-menu__list--condensed{% endif %}"
                    role="list"
                  >
                    {%- for childlink in link.links -%}
                      <li class="{% if has_sublinks %}mega-menu__column{% else %}mega-menu__inline-item{% endif %}">
                        <a
                          id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                          href="{{ childlink.url }}"
                          class="{% if has_sublinks %}mega-menu__link mega-menu__link--level-2 link{% if childlink.current %} mega-menu__link--active{% endif %}{% else %}mega-menu__pill-link link{% if childlink.current %} mega-menu__pill-link--active{% endif %}{% endif %}"
                          {% if childlink.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ childlink.title | escape }}
                        </a>
                        {%- if childlink.links != blank -%}
                          <ul class="list-unstyled mega-menu__sublist" role="list">
                            {%- for grandchildlink in childlink.links -%}
                              <li>
                                <a
                                  id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                  href="{{ grandchildlink.url }}"
                                  class="mega-menu__link link{% if grandchildlink.current %} mega-menu__link--active{% endif %}"
                                  {% if grandchildlink.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  {{ grandchildlink.title | escape }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                  {%- if matching_promo -%}
                    {%- assign card_style = matching_promo.settings.card_style | default: 'overlay' -%}
                    {%- assign promo_url = matching_promo.settings.link | default: matching_promo.settings.collection.url -%}
                    <div class="mega-menu__promo" {{ matching_promo.shopify_attributes }}>
                      {%- if promo_url != blank -%}
                        <a href="{{ promo_url }}" class="mega-menu__promo-link full-unstyled-link">
                      {%- endif -%}
                      <div class="mega-menu__promo-banner mega-menu__promo-banner--{{ card_style }}">
                        {%- if matching_promo.settings.image != blank -%}
                          <div class="mega-menu__promo-media">
                            {{
                              matching_promo.settings.image
                              | image_url: width: 800
                              | image_tag:
                                loading: 'lazy',
                                class: 'mega-menu__promo-img',
                                widths: '300, 450, 600, 800',
                                alt: matching_promo.settings.heading | default: matching_promo.settings.menu_item_title | escape
                            }}
                          </div>
                        {%- else -%}
                          <div class="mega-menu__promo-media mega-menu__promo-media--placeholder">
                            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg mega-menu__promo-img' }}
                          </div>
                        {%- endif -%}

                        {%- if card_style == 'overlay' -%}
                          <div class="mega-menu__promo-overlay" style="--overlay-op: {{ matching_promo.settings.overlay_opacity | default: 35 | divided_by: 100.0 }};"></div>
                        {%- endif -%}

                        <div class="mega-menu__promo-content">
                          {%- if matching_promo.settings.badge_text != blank -%}
                            <span class="mega-menu__promo-badge">{{ matching_promo.settings.badge_text | escape }}</span>
                          {%- endif -%}

                          {%- if matching_promo.settings.heading != blank -%}
                            <h4 class="mega-menu__promo-title">{{ matching_promo.settings.heading | escape }}</h4>
                          {%- endif -%}

                          {%- if matching_promo.settings.subheading != blank -%}
                            <p class="mega-menu__promo-subtitle">{{ matching_promo.settings.subheading | escape }}</p>
                          {%- endif -%}

                          {%- if matching_promo.settings.button_label != blank -%}
                            <span class="mega-menu__promo-cta">
                              {{ matching_promo.settings.button_label | escape }}
                            </span>
                          {%- endif -%}
                        </div>
                      </div>
                      {%- if promo_url != blank -%}
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
