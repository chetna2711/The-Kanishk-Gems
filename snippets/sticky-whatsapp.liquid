{%- liquid
  assign enable_whatsapp = settings.enable_sticky_whatsapp
  if enable_whatsapp == nil
    assign enable_whatsapp = true
  endif
  assign raw_whatsapp = settings.contact_whatsapp
  assign default_message = settings.contact_whatsapp_message | default: 'Hello Hency Jewels! I am interested in your jewellery collection and would like to know more details.'
-%}

{%- if enable_whatsapp and raw_whatsapp != blank -%}
  {%- assign clean_number = raw_whatsapp | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
  {%- assign whatsapp_url = 'https://wa.me/' | append: clean_number -%}
  {%- if default_message != blank -%}
    {%- assign encoded_message = default_message | url_encode -%}
    {%- assign whatsapp_url = whatsapp_url | append: '?text=' | append: encoded_message -%}
  {%- endif -%}
  <aside aria-label="WhatsApp Support">
    <a
      href="{{ whatsapp_url }}"
      class="sticky-whatsapp-btn"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat on WhatsApp"
    >
      <span class="sticky-whatsapp-btn__icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="34" height="34" fill="#ffffff" aria-hidden="true">
          <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
        </svg>
      </span>
      <span class="sticky-whatsapp-btn__tooltip">Chat with us</span>
    </a>
  </aside>

  <style>
    .sticky-whatsapp-btn {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 990;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background-color: #25D366;
      color: #ffffff !important;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(37, 211, 102, 0.42), 0 2px 6px rgba(0, 0, 0, 0.15);
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s ease, background-color 0.2s ease;
      cursor: pointer;
    }

    .sticky-whatsapp-btn:hover {
      background-color: #20BA5A;
      transform: scale(1.08);
      box-shadow: 0 6px 20px rgba(37, 211, 102, 0.55), 0 3px 8px rgba(0, 0, 0, 0.2);
      color: #ffffff !important;
    }

    .sticky-whatsapp-btn:active {
      transform: scale(0.96);
    }

    .sticky-whatsapp-btn__icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      color: #ffffff;
    }

    .sticky-whatsapp-btn__icon svg {
      width: 32px;
      height: 32px;
      fill: #ffffff;
      display: block;
    }

    .sticky-whatsapp-btn__tooltip {
      position: absolute;
      right: calc(100% + 12px);
      top: 50%;
      transform: translateY(-50%);
      background: #111111;
      color: #ffffff;
      padding: 6px 12px;
      font-size: 13px;
      font-weight: 500;
      border-radius: 6px;
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
    }

    .sticky-whatsapp-btn__tooltip::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 100%;
      transform: translateY(-50%);
      border-width: 5px;
      border-style: solid;
      border-color: transparent transparent transparent #111111;
    }

    @media (hover: hover) {
      .sticky-whatsapp-btn:hover .sticky-whatsapp-btn__tooltip {
        opacity: 1;
        visibility: visible;
        transform: translateY(-50%) translateX(-2px);
      }
    }

    @media screen and (max-width: 749px) {
      .sticky-whatsapp-btn {
        bottom: 20px;
        right: 18px;
        width: 52px;
        height: 52px;
      }
      .sticky-whatsapp-btn__icon svg {
        width: 28px;
        height: 28px;
      }
      .sticky-whatsapp-btn__tooltip {
        display: none !important;
      }
    }
  </style>
{%- endif -%}
