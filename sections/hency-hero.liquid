{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #HencyHero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background-color: var(--hency-cream, #f6f3ed);
  }

  .hency-hero__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hency-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_focal_position }};
    display: block;
  }

  .hency-hero__image--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    {%- if section.settings.mobile_image != blank -%}
      .hency-hero__image--desktop {
        display: none;
      }
      .hency-hero__image--mobile {
        display: block;
      }
    {%- endif -%}
  }

  .hency-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #000000;
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
    pointer-events: none;
  }

  .hency-hero__container {
    position: relative;
    z-index: 3;
    display: flex;
    box-sizing: border-box;
    width: 100%;
    min-height: {{ section.settings.hero_height_desktop }};
    padding: 6rem 2rem;
  }

  @media screen and (max-width: 749px) {
    .hency-hero__container {
      min-height: {{ section.settings.hero_height_mobile }};
      padding: 4rem 1.5rem;
    }
  }

  /* Content Alignment & Positioning */
  .hency-hero__container--pos-middle-center {
    align-items: center;
    justify-content: center;
  }
  .hency-hero__container--pos-middle-left {
    align-items: center;
    justify-content: flex-start;
  }
  .hency-hero__container--pos-middle-right {
    align-items: center;
    justify-content: flex-end;
  }
  .hency-hero__container--pos-top-left {
    align-items: flex-start;
    justify-content: flex-start;
  }
  .hency-hero__container--pos-top-center {
    align-items: flex-start;
    justify-content: center;
  }
  .hency-hero__container--pos-bottom-left {
    align-items: flex-end;
    justify-content: flex-start;
  }
  .hency-hero__container--pos-bottom-center {
    align-items: flex-end;
    justify-content: center;
  }

  .hency-hero__content {
    max-width: {{ section.settings.content_max_width }}rem;
    text-align: {{ section.settings.text_alignment }};
    color: {%- if section.settings.text_color != blank and section.settings.text_color != 'rgba(0,0,0,0)' -%}{{ section.settings.text_color }}{%- else -%}#ffffff{%- endif -%};
  }

  .hency-hero__eyebrow {
    font-size: 1.3rem;
    letter-spacing: 0.25rem;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 1.2rem;
    display: block;
    color: var(--hency-gold, #c5a059);
  }

  .hency-hero__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(3rem, 5.5vw, 6rem);
    line-height: 1.1;
    margin: 0 0 1.6rem;
    font-weight: var(--font-heading-weight, 500);
    letter-spacing: 0.04em;
    color: inherit;
  }

  .hency-hero__description {
    font-size: clamp(1.5rem, 2vw, 1.9rem);
    line-height: 1.5;
    margin: 0 0 2.8rem;
    opacity: 0.92;
    color: inherit;
  }

  .hency-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    {%- if section.settings.text_alignment == 'center' -%}
      justify-content: center;
    {%- elsif section.settings.text_alignment == 'right' -%}
      justify-content: flex-end;
    {%- else -%}
      justify-content: flex-start;
    {%- endif -%}
  }

  .hency-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.4rem 3.2rem;
    font-size: 1.4rem;
    letter-spacing: 0.12rem;
    text-transform: uppercase;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    border-radius: 0;
    cursor: pointer;
  }

  .hency-hero__btn--primary {
    background-color: var(--hency-gold, #c5a059);
    color: #ffffff;
    border: 1px solid var(--hency-gold, #c5a059);
  }

  .hency-hero__btn--primary:hover {
    background-color: #1a1a1a;
    border-color: #1a1a1a;
    color: #ffffff;
  }

  .hency-hero__btn--secondary {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid #ffffff;
  }

  .hency-hero__btn--secondary:hover {
    background-color: #ffffff;
    color: #1a1a1a;
  }
{%- endstyle -%}

<div id="HencyHero-{{ section.id }}" class="hency-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="hency-hero__media">
    {%- if section.settings.desktop_image != blank -%}
      {{
        section.settings.desktop_image
        | image_url: width: 3840
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'hency-hero__image hency-hero__image--desktop',
          widths: '750, 1100, 1500, 1780, 2000, 3000, 3840',
          alt: section.settings.desktop_image.alt | default: section.settings.heading | escape
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg hency-hero__image' }}
    {%- endif -%}

    {%- if section.settings.mobile_image != blank -%}
      {{
        section.settings.mobile_image
        | image_url: width: 1500
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'hency-hero__image hency-hero__image--mobile',
          widths: '375, 550, 750, 1100, 1500',
          alt: section.settings.mobile_image.alt | default: section.settings.heading | escape
      }}
    {%- endif -%}
  </div>

  <div class="hency-hero__overlay"></div>

  <div class="page-width">
    <div class="hency-hero__container hency-hero__container--pos-{{ section.settings.text_position }}">
      <div class="hency-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="hency-hero__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="hency-hero__heading">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="hency-hero__description">
            <p>{{ section.settings.description | escape }}</p>
          </div>
        {%- endif -%}

        {%- if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank -%}
          <div class="hency-hero__buttons">
            {%- if section.settings.primary_button_label != blank -%}
              <a
                href="{{ section.settings.primary_button_link | default: routes.all_products_collection_url }}"
                class="hency-hero__btn hency-hero__btn--primary"
              >
                {{ section.settings.primary_button_label | escape }}
              </a>
            {%- endif -%}

            {%- if section.settings.secondary_button_label != blank -%}
              <a
                href="{{ section.settings.secondary_button_link | default: routes.all_products_collection_url }}"
                class="hency-hero__btn hency-hero__btn--secondary"
              >
                {{ section.settings.secondary_button_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hency Hero Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop banner image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile banner image (optional)"
    },
    {
      "type": "select",
      "id": "image_focal_position",
      "label": "Image focal position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top center" },
        { "value": "bottom center", "label": "Bottom center" },
        { "value": "center left", "label": "Center left" },
        { "value": "center right", "label": "Center right" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "hero_height_desktop",
      "label": "Desktop height",
      "options": [
        { "value": "500px", "label": "Small (500px)" },
        { "value": "650px", "label": "Medium (650px)" },
        { "value": "800px", "label": "Large (800px)" },
        { "value": "100vh", "label": "Full screen (100vh)" }
      ],
      "default": "650px"
    },
    {
      "type": "select",
      "id": "hero_height_mobile",
      "label": "Mobile height",
      "options": [
        { "value": "400px", "label": "Small (400px)" },
        { "value": "500px", "label": "Medium (500px)" },
        { "value": "650px", "label": "Large (650px)" },
        { "value": "85vh", "label": "Full viewport (85vh)" }
      ],
      "default": "500px"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Dark overlay opacity",
      "default": 25
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag",
      "default": "Artisan Crafted Fine Jewellery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "JEWELLERY THAT TELLS YOUR STORY"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Subheading / Description",
      "default": "Timeless pieces crafted to complement every celebration, every mood and every moment."
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "rem",
      "label": "Content max width",
      "default": 65
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "middle-left", "label": "Middle Left" },
        { "value": "middle-center", "label": "Middle Center" },
        { "value": "middle-right", "label": "Middle Right" },
        { "value": "top-left", "label": "Top Left" },
        { "value": "top-center", "label": "Top Center" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-center", "label": "Bottom Center" }
      ],
      "default": "middle-left"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Button text",
      "default": "Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Button text",
      "default": "Explore Mangalsutras"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    }
  ],
  "presets": [
    {
      "name": "Hency Hero Banner"
    }
  ]
}
{% endschema %}
