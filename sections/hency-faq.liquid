{%- style -%}
  #HencyFAQ-{{ section.id }} {
    background-color: var(--hency-cream, #f6f3ed);
    padding-top: calc(var(--spacing-sections-mobile, 0px));
    padding-bottom: calc(var(--spacing-sections-mobile, 0px));
  }

  @media screen and (min-width: 750px) {
    #HencyFAQ-{{ section.id }} {
      padding-top: calc(var(--spacing-sections-desktop, 0px));
      padding-bottom: calc(var(--spacing-sections-desktop, 0px));
    }
  }

  #HencyFAQ-{{ section.id }} .faq__header {
    text-align: center;
    max-width: 68rem;
    margin: 0 auto 3.8rem;
  }

  #HencyFAQ-{{ section.id }} .faq__eyebrow {
    color: var(--hency-gold, #c5a059);
    font-size: 1.2rem;
    letter-spacing: 0.25rem;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 0.8rem;
    display: block;
  }

  #HencyFAQ-{{ section.id }} .faq__title {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 3.5vw, 3.8rem);
    line-height: 1.2;
    margin: 0;
    font-weight: var(--font-heading-weight, 500);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--hency-charcoal, #1a1a1a);
  }

  #HencyFAQ-{{ section.id }} .faq__description {
    color: rgba(26, 26, 26, 0.75);
    margin: 1.2rem auto 0;
    font-size: 1.5rem;
    line-height: 1.5;
  }

  #HencyFAQ-{{ section.id }} .faq__accordion-list {
    max-width: 82rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  #HencyFAQ-{{ section.id }} .faq__item {
    background: #ffffff;
    border: 1px solid var(--hency-border-subtle, rgba(197, 160, 89, 0.25));
    border-radius: 4px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03);
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  #HencyFAQ-{{ section.id }} .faq__item[open] {
    border-color: var(--hency-gold, #c5a059);
    box-shadow: 0 8px 24px rgba(197, 160, 89, 0.12);
  }

  #HencyFAQ-{{ section.id }} .faq__summary {
    padding: 2rem 2.4rem;
    font-family: var(--font-heading-family);
    font-size: 1.7rem;
    font-weight: 600;
    color: var(--hency-charcoal, #1a1a1a);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    user-select: none;
    outline: none;
  }
  #HencyFAQ-{{ section.id }} .faq__summary::-webkit-details-marker {
    display: none;
  }

  #HencyFAQ-{{ section.id }} .faq__icon {
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    background: var(--hency-cream, #f6f3ed);
    color: var(--hency-gold, #c5a059);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    flex-shrink: 0;
    transition: transform 0.3s ease, background 0.3s ease, color 0.3s ease;
  }

  #HencyFAQ-{{ section.id }} .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--hency-gold, #c5a059);
    color: #ffffff;
  }

  #HencyFAQ-{{ section.id }} .faq__content {
    padding: 0 2.4rem 2.4rem;
    font-size: 1.45rem;
    line-height: 1.65;
    color: rgba(26, 26, 26, 0.8);
  }
{%- endstyle -%}

<section id="HencyFAQ-{{ section.id }}" class="hency-faq color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="faq__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="faq__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="faq__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="faq__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="faq__accordion-list">
        {%- for block in section.blocks -%}
          <details class="faq__item" {% if forloop.first and section.settings.open_first_item %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="faq__summary">
              <span>{{ block.settings.question | escape }}</span>
              <span class="faq__icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq__content rte">
              {{ block.settings.answer }}
            </div>
          </details>
        {%- endfor -%}
      </div>

      {%- if section.settings.enable_faq_schema -%}
        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
              {%- for block in section.blocks -%}
                {
                  "@type": "Question",
                  "name": {{ block.settings.question | json }},
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": {{ block.settings.answer | strip_html | json }}
                  }
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          }
        </script>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag",
      "default": "CLEAR GUIDANCE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Everything you need to know about our craftsmanship, materials, sizing and shipping.</p>"
    },
    {
      "type": "checkbox",
      "id": "open_first_item",
      "label": "Keep first question open by default",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_faq_schema",
      "label": "Output FAQ schema.org structured data",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question & Answer",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What materials are used in HencyJewels pieces?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Our jewels are crafted from premium hypoallergenic brass and silver alloys, layered with high-grade micron gold plating and adorned with hand-set simulated uncut polki, kundan, and cubic zirconia crystals.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "What materials are used in HencyJewels pieces?",
            "answer": "<p>Our jewellery is crafted using skin-safe, hypoallergenic brass and copper alloys, coated with durable micro-gold plating and adorned with precision-cut stones and genuine Kundan work.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How should I care for my jewellery to maintain its shine?",
            "answer": "<p>Store your jewellery in airtight zip pouches away from moisture, perfumes and harsh sprays. Wipe gently with a dry lint-free cloth after each wear.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How long does shipping take across India?",
            "answer": "<p>Orders are dispatched within 24-48 hours. Delivery takes 3-5 business days for major metropolitan areas and 5-7 business days for other regions.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is your exchange and return policy?",
            "answer": "<p>We offer a hassle-free 15-day exchange policy for all unworn items retained in their original packaging and security tags.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
