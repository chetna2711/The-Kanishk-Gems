{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign banner_img = collection.metafields.custom.collection_banner_image.value | default: collection.image
  assign mobile_banner_img = collection.metafields.custom.collection_mobile_banner_image.value
  assign subtitle = collection.metafields.custom.collection_subtitle.value
  assign promo_content = collection.metafields.custom.collection_promo_content.value
-%}

{%- style -%}
  .collection-hero {
    background-color: var(--hency-ivory, #fafaf7);
    border-bottom: 1px solid var(--hency-border-subtle, rgba(197, 160, 89, 0.2));
  }

  .collection-hero__inner {
    padding-top: 2rem;
    padding-bottom: 3.5rem;
  }

  .collection-hero__subtitle {
    color: var(--hency-gold, #c5a059);
    font-size: 1.3rem;
    letter-spacing: 0.22rem;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 0.8rem;
    display: block;
  }

  .collection-hero__title {
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 4vw, 4.2rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--hency-charcoal, #1a1a1a);
    margin: 0 0 1.2rem;
  }

  .collection-hero__promo-pill {
    display: inline-block;
    background: var(--hency-cream, #f6f3ed);
    border: 1px solid var(--hency-gold, #c5a059);
    color: var(--hency-gold, #c5a059);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 0.4rem 1.4rem;
    border-radius: 999px;
    margin-top: 1.2rem;
  }

  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
    {%- if mobile_banner_img != blank -%}
      .collection-hero__img--desktop {
        display: none;
      }
      .collection-hero__img--mobile {
        display: block !important;
      }
    {%- endif -%}
  }
{%- endstyle -%}

<div class="collection-hero{% if section.settings.show_collection_image and banner_img %} collection-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="collection-hero__text-wrapper">
      {%- if subtitle != blank -%}
        <span class="collection-hero__subtitle">{{ subtitle | escape }}</span>
      {%- endif -%}

      <h1 class="collection-hero__title">
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {{- collection.title | escape -}}
      </h1>

      {%- if section.settings.show_collection_description and collection.description != blank -%}
        <div class="collection-hero__description rte">{{ collection.description }}</div>
      {%- endif -%}

      {%- if promo_content != blank -%}
        <div class="collection-hero__promo-pill">
          ✦ {{ promo_content | escape }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and banner_img -%}
      <div class="collection-hero__image-container media gradient" style="border-radius: 4px; overflow: hidden; border: 1px solid var(--hency-border-subtle, rgba(197, 160, 89, 0.25));">
        {%- if mobile_banner_img != blank -%}
          {{
            mobile_banner_img
            | image_url: width: 800
            | image_tag:
              class: 'collection-hero__img--mobile',
              loading: 'lazy',
              style: 'display: none;',
              alt: collection.title | escape
          }}
        {%- endif -%}

        {{
          banner_img
          | image_url: width: 1500
          | image_tag:
            class: 'collection-hero__img--desktop',
            loading: 'lazy',
            widths: '360, 535, 750, 1070, 1500',
            alt: collection.title | escape
        }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection Banner",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": true,
      "label": "Show collection image or custom metafield banner"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
