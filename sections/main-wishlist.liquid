{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}

<section class="wishlist-page page-width">
  <div class="wishlist-page__header">
    <span class="wishlist-page__eyebrow">YOUR SAVED PIECES</span>
    <h1 class="main-page-title page-title h0 wishlist-page__title">{{ page.title | default: 'My Wishlist' | escape }}</h1>
    <p class="wishlist-page__subtitle">Review and shop your favorite handcrafted jewellery designs</p>
  </div>

  <div class="wishlist-page__empty" data-wishlist-empty hidden>
    <div class="wishlist-page__empty-icon">
      {% render 'icon-wishlist' %}
    </div>
    <h2>Your wishlist is empty</h2>
    <p>Explore our handcrafted jewelry collections and save your favorite designs to view them anytime.</p>
    <a href="{{ routes.all_products_collection_url }}" class="button button--primary">Explore Collection</a>
  </div>

  <ul
    id="product-grid"
    class="grid product-grid grid--2-col-tablet-down grid--4-col-desktop wishlist-page__grid"
    data-wishlist-products
    data-root-url="{{ routes.root_url }}"
    aria-live="polite"
  ></ul>
</section>

{% schema %}
{
  "name": "Wishlist page",
  "settings": []
}
{% endschema %}
