            "value": "hencyjewels@gmail.com",
            "link": "mailto:hencyjewels@gmail.com",
            "description": "General, business, bespoke styling, and collaboration enquiries.",
            "action_label": "Write to us",
            "action_url": "mailto:hencyjewels@gmail.com"
          }
        },
        {
          "type": "channel",
          "settings": {
            "icon": "support",
            "category": "CUSTOMER ASSISTANCE",
