{{ 'section-hency-about-contact.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #HencyContactDetails-{{ section.id }} {
    padding-top: calc(var(--spacing-sections-mobile, 0px));
    padding-bottom: calc(var(--spacing-sections-mobile, 0px));
    {%- if section.settings.bg_color != blank -%}
      background-color: {{ section.settings.bg_color }};
    {%- endif -%}
  }

  @media screen and (min-width: 750px) {
    #HencyContactDetails-{{ section.id }} {
      padding-top: calc(var(--spacing-sections-desktop, 0px));
      padding-bottom: calc(var(--spacing-sections-desktop, 0px));
    }
  }
{%- endstyle -%}

<div
  id="HencyContactDetails-{{ section.id }}"
  class="hency-contact-details color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="hency-contact-details__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="hency-page-header__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="hency-page-header__title" style="font-size: clamp(2.4rem, 3.2vw, 3.8rem);">
          {{ section.settings.heading | escape }}
        </h2>
        {%- if section.settings.description != blank -%}
          <p class="hency-page-header__subtitle">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="hency-card-grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'channel' -%}
            <article class="hency-contact-card" {{ block.shopify_attributes }}>
              <div class="hency-contact-card__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'phone' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                  {%- when 'email' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                    </svg>
                  {%- when 'support' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                    </svg>
                  {%- when 'clock' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <path d="M12 16v-4"></path>
                      <path d="M12 8h.01"></path>
                    </svg>
                {%- endcase -%}
              </div>

              {%- if block.settings.category != blank -%}
                <span class="hency-contact-card__category">{{ block.settings.category | escape }}</span>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h3 class="hency-contact-card__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.value != blank -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="hency-contact-card__value">
                    {{ block.settings.value | escape }}
                  </a>
                {%- else -%}
                  <span class="hency-contact-card__value" style="color: var(--hency-charcoal, #1a1a1a);">
                    {{ block.settings.value | escape }}
                  </span>
                {%- endif -%}
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="hency-contact-card__desc">{{ block.settings.description | escape }}</p>
              {%- endif -%}

              {%- if block.settings.action_label != blank and block.settings.action_url != blank -%}
                <a href="{{ block.settings.action_url }}" class="hency-contact-card__action">
                  <span>{{ block.settings.action_label | escape }}</span>
                  <span aria-hidden="true">→</span>
                </a>
              {%- endif -%}
            </article>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hency Contact Channels",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "CONTACT OPTIONS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose the right channel"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "For faster assistance, please use the contact option that best matches your enquiry."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background color (optional)"
    }
  ],
  "blocks": [
    {
      "type": "channel",
      "name": "Contact Channel Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "support",
              "label": "Customer Support Chat"
            },
            {
              "value": "clock",
              "label": "Operating Hours Clock"
            }
          ],
          "default": "phone"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category tag",
          "default": "CALL OR WHATSAPP"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Channel title",
          "default": "Customer Care"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Primary contact info",
          "default": "+91 73592 15333"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Contact info link (tel: or mailto:)"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description",
          "default": "Product questions, order assistance and delivery support."
        },
        {
          "type": "text",
          "id": "action_label",
          "label": "CTA link label (optional)",
          "default": "Start WhatsApp chat"
        },
        {
          "type": "url",
          "id": "action_url",
          "label": "CTA link URL (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hency Contact Channels",
      "blocks": [
        {
          "type": "channel",
          "settings": {
            "icon": "phone",
            "category": "CALL OR WHATSAPP",
            "title": "Customer Care",
            "value": "+91 73592 15333",
            "link": "tel:+917359215333",
            "description": "Product questions, order assistance and delivery support.",
            "action_label": "Start WhatsApp chat",
            "action_url": "https://wa.me/917359215333"
          }
        },
        {
          "type": "channel",
          "settings": {
            "icon": "email",
            "category": "GENERAL ENQUIRIES",
