{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #TrendingCollection-{{ section.id }} {
    background: var(--brand-background, #fefefe);
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__heading-row {
    align-items: end;
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    margin-bottom: 2.4rem;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__heading {
    color: var(--brand-text, #1f0e08);
    font-size: 25px;
        font-family: var(--font-heading-family);

    line-height: 1.1;
    margin: 0;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__description {
    color: var(--brand-text, #1f0e08);
    margin: .8rem 0 0;
    max-width: 65rem;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__header-button {
    flex: 0 0 auto;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__layout {
    align-items: stretch;
    display: grid;
    gap: 1.6rem;
    grid-template-columns: minmax(0, 3fr) minmax(0, 3fr);
  }

  #TrendingCollection-{{ section.id }} .trending-collection__layout--right .trending-collection__banner { order: 2; }
  #TrendingCollection-{{ section.id }} .trending-collection__layout--right .trending-collection__products { order: 1; }

  #TrendingCollection-{{ section.id }} .trending-collection__banner {
    background: var(--brand-cream, #f5ece3);
    min-height: 0;
    overflow: hidden;
    position: relative;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__banner-image {
    display: block;
    height: 100%;
    object-fit: fill;
    position: absolute;
    width: 100%;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__banner-image--mobile { display: none; }

  #TrendingCollection-{{ section.id }} .trending-collection__banner-placeholder {
    background: var(--brand-cream, #f5ece3);
    display: block;
    height: 100%;
    min-height: 100%;
    width: 100%;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__banner-content {
    align-items: flex-start;
    box-sizing: border-box;
    color: #fff;
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: center;
    min-height: 100%;
    padding: clamp(2rem, 4vw, 5rem);
    position: relative;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__banner-title {
    color: inherit;
    font-family: var(--font-heading-family);
    font-size: 35px;
    line-height: 1.08;
    margin: 0;
    width:100%;
    max-width:250px;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__banner-description { margin: 1.4rem 0 0; }
  #TrendingCollection-{{ section.id }} .trending-collection__banner-button { margin-top: 2rem; }

  #TrendingCollection-{{ section.id }} .trending-collection__products-wrapper {
    min-width: 0;
    position: relative;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__products {
    -ms-overflow-style: none;
    gap: 1.6rem;
    display: flex;
    overflow-x: auto;
    padding: .2rem;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__products::-webkit-scrollbar { display: none; }

  #TrendingCollection-{{ section.id }} .trending-collection__products .grid__item {
    box-sizing: border-box;
    flex: 0 0 calc((100% - 3.2rem) / 3);
    min-width: 0;
    scroll-snap-align: start;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__products .product-card-wrapper,
  #TrendingCollection-{{ section.id }} .trending-collection__products .card { height: 100%; }

  #TrendingCollection-{{ section.id }} .trending-collection__products .card {
    background: #fff;
    border-radius: .4rem;
    box-shadow: 0 .4rem 1.2rem rgba(31, 14, 8, .06);
    overflow: hidden;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__products .card__inner { border-radius: 0; }

  #TrendingCollection-{{ section.id }} .trending-collection__products .card__content { padding: 1.2rem 1.2rem 1.4rem; }

  #TrendingCollection-{{ section.id }} .trending-collection__products .card__heading {
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    display: -webkit-box;
    font-size: 1.45rem;
    line-height: 1.35;
    min-height: 3.9rem;
    overflow: hidden;
    overflow-wrap: anywhere;
    text-overflow: ellipsis;
    white-space: normal;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__products .price { margin-top: .7rem; }

  #TrendingCollection-{{ section.id }} .trending-collection__slider-button {
    align-items: center;
    background: #fff;
    border: 1px solid rgba(31, 14, 8, .2);
    border-radius: 50%;
    box-shadow: 0 .2rem .8rem rgba(31, 14, 8, .14);
    color: var(--brand-text, #1f0e08);
    cursor: pointer;
    display: flex;
    height: 3.6rem;
    justify-content: center;
    padding: 0;
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    width: 3.6rem;
    z-index: 2;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__slider-button--previous { left: -1.8rem; }
  #TrendingCollection-{{ section.id }} .trending-collection__slider-button--next { right: -1.8rem; }
  #TrendingCollection-{{ section.id }} .trending-collection__slider-button:disabled { cursor: default; opacity: .35; }

  @media screen and (min-width: 750px) {
    #TrendingCollection-{{ section.id }} {
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-top: {{ section.settings.padding_top }}px;
    }
  }

  @media screen and (max-width: 989px) {
    #TrendingCollection-{{ section.id }} .trending-collection__layout { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
    #TrendingCollection-{{ section.id }} .trending-collection__products .grid__item { flex-basis: calc((100% - 1.6rem) / 2); }
  }

  @media screen and (max-width: 749px) {
    #TrendingCollection-{{ section.id }} .trending-collection__heading-row { align-items: flex-start; flex-direction: column; margin-bottom: 1.8rem; }
    #TrendingCollection-{{ section.id }} .trending-collection__layout { display: flex; flex-direction: column; }
    #TrendingCollection-{{ section.id }} .trending-collection__layout--right .trending-collection__banner,
    #TrendingCollection-{{ section.id }} .trending-collection__layout--right .trending-collection__products { order: initial; }
    #TrendingCollection-{{ section.id }} .trending-collection__banner-content,
    #TrendingCollection-{{ section.id }} .trending-collection__banner-placeholder { min-height: 28rem; }
    #TrendingCollection-{{ section.id }} .trending-collection__banner--has-mobile .trending-collection__banner-image--desktop { display: none; }
    #TrendingCollection-{{ section.id }} .trending-collection__banner-image--mobile { display: block; }
    #TrendingCollection-{{ section.id }} .trending-collection__products { gap: 1rem; }
    #TrendingCollection-{{ section.id }} .trending-collection__products .grid__item { flex-basis: calc((100% - 1rem) / 2); }
    #TrendingCollection-{{ section.id }} .trending-collection__slider-button { display: none; }
  }
{%- endstyle -%}

<section id="TrendingCollection-{{ section.id }}" class="trending-collection">
  <div class="page-width">
    <div class="trending-collection__heading-row">
      <div>
        {%- if section.settings.title != blank -%}<h2 class="trending-collection__heading">{{ section.settings.title | escape }}</h2>{%- endif -%}
        {%- if section.settings.description != blank -%}<div class="trending-collection__description rte">{{ section.settings.description }}</div>{%- endif -%}
      </div>
      {%- if section.settings.header_button_label != blank -%}
        <a class="button button--secondary trending-collection__header-button" href="{{ section.settings.header_button_link | default: '#' }}">{{ section.settings.header_button_label | escape }}</a>
      {%- endif -%}
    </div>

    <div class="trending-collection__layout trending-collection__layout--{{ section.settings.banner_position }}">
      <div class="trending-collection__banner{% if section.settings.mobile_image != blank %} trending-collection__banner--has-mobile{% endif %}">
        {%- if section.settings.desktop_image != blank -%}
          {{ section.settings.desktop_image | image_url: width: 1600 | image_tag: class: 'trending-collection__banner-image trending-collection__banner-image--desktop', loading: 'lazy', widths: '500, 750, 1000, 1600' }}
        {%- else -%}
          <div class="trending-collection__banner-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endif -%}
        {%- if section.settings.mobile_image != blank -%}
          {{ section.settings.mobile_image | image_url: width: 1000 | image_tag: class: 'trending-collection__banner-image trending-collection__banner-image--mobile', loading: 'lazy', widths: '400, 600, 800, 1000' }}
        {%- endif -%}
        <div class="trending-collection__banner-content">
          {%- if section.settings.banner_title != blank -%}<h3 class="trending-collection__banner-title">{{ section.settings.banner_title | escape }}</h3>{%- endif -%}
          {%- if section.settings.banner_description != blank -%}<div class="trending-collection__banner-description rte">{{ section.settings.banner_description }}</div>{%- endif -%}
          {%- if section.settings.banner_button_label != blank -%}<a class="button trending-collection__banner-button" href="{{ section.settings.banner_button_link | default: '#' }}">{{ section.settings.banner_button_label | escape }}</a>{%- endif -%}
        </div>
      </div>

      <div class="trending-collection__products-wrapper">
        <div class="trending-collection__products" data-trending-products>
          {%- if section.settings.collection != blank -%}
            {%- for product in section.settings.collection.products limit: 12 -%}
              <div class="grid__item">
                {% render 'card-product', card_product: product, media_aspect_ratio: 'square', show_secondary_image: false, show_vendor: false, show_rating: false, quick_add: 'standard', section_id: section.id %}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..3) -%}
              {%- assign placeholder_image = 'product-apparel-' | append: i -%}
              <div class="grid__item">{% render 'card-product', placeholder_image: placeholder_image %}</div>
            {%- endfor -%}
          {%- endif -%}
        </div>
        {%- if section.settings.collection != blank and section.settings.collection.products_count > 3 -%}
          <button class="trending-collection__slider-button trending-collection__slider-button--previous" type="button" aria-label="Previous products" data-trending-previous>←</button>
          <button class="trending-collection__slider-button trending-collection__slider-button--next" type="button" aria-label="Next products" data-trending-next>→</button>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const initialiseTrendingCollection = () => {
      const section = document.getElementById('TrendingCollection-{{ section.id }}');
      const products = section && section.querySelector('[data-trending-products]');
      const previous = section && section.querySelector('[data-trending-previous]');
      const next = section && section.querySelector('[data-trending-next]');

      if (!products || !previous || !next || products.dataset.sliderReady === 'true') return;
      products.dataset.sliderReady = 'true';

      const updateButtons = () => {
        previous.disabled = products.scrollLeft <= 1;
        next.disabled = products.scrollLeft + products.clientWidth >= products.scrollWidth - 1;
      };

      previous.addEventListener('click', () => products.scrollBy({ left: -products.clientWidth, behavior: 'smooth' }));
      next.addEventListener('click', () => products.scrollBy({ left: products.clientWidth, behavior: 'smooth' }));
      products.addEventListener('scroll', updateButtons, { passive: true });
      window.addEventListener('resize', updateButtons);
      updateButtons();
    };

    initialiseTrendingCollection();
    document.addEventListener('shopify:section:load', initialiseTrendingCollection);
  })();
</script>

{% schema %}
{
  "name": "Trending collection",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "title", "label": "Section title", "default": "Trending collection" },
    { "type": "richtext", "id": "description", "label": "Section description" },
    { "type": "text", "id": "header_button_label", "label": "Section button label", "default": "View all" },
    { "type": "url", "id": "header_button_link", "label": "Section button link" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "select", "id": "banner_position", "label": "Banner position", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }] },
    { "type": "header", "content": "Banner content" },
    { "type": "image_picker", "id": "desktop_image", "label": "Banner image (desktop)" },
    { "type": "image_picker", "id": "mobile_image", "label": "Banner image (mobile)" },
    { "type": "text", "id": "banner_title", "label": "Banner title", "default": "Golden Grace Collection" },
    { "type": "richtext", "id": "banner_description", "label": "Banner description", "default": "<p>Crafted to complement your grace.</p>" },
    { "type": "text", "id": "banner_button_label", "label": "Banner button label", "default": "Shop now" },
    { "type": "url", "id": "banner_button_link", "label": "Banner button link" },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "presets": [{ "name": "Trending collection" }]
}
{% endschema %}
