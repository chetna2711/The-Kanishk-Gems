{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #TrendingCollection-{{ section.id }} {
    background: var(--brand-background, #fefefe);
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__heading-row {
    align-items: end;
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    margin-bottom: 2.4rem;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__heading {
    color: var(--brand-text, #1f0e08);
    font-family: 25px;
    font-size: clamp(2.3rem, 3vw, 4rem);
    line-height: 1.1;
    margin: 0;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__description {
    color: var(--brand-text, #1f0e08);
    margin: .8rem 0 0;
    max-width: 65rem;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__header-button {
    flex: 0 0 auto;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__layout {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: minmax(26rem, 1.25fr) minmax(0, 2.75fr);
  }

  #TrendingCollection-{{ section.id }} .trending-collection__layout--right .trending-collection__banner { order: 2; }
  #TrendingCollection-{{ section.id }} .trending-collection__layout--right .trending-collection__products { order: 1; }

  #TrendingCollection-{{ section.id }} .trending-collection__banner {
    min-height: 100%;
    overflow: hidden;
    position: relative;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__banner-image {
    display: block;
    height: 100%;
    object-fit: cover;
    position: absolute;
    width: 100%;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__banner-image--mobile { display: none; }

  #TrendingCollection-{{ section.id }} .trending-collection__banner-placeholder {
    background: var(--brand-cream, #f5ece3);
    display: block;
    height: 100%;
    min-height: 32rem;
    width: 100%;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__banner-content {
    align-items: flex-start;
    background: linear-gradient(90deg, rgba(31, 14, 8, .7), rgba(31, 14, 8, .12));
    box-sizing: border-box;
    color: #fff;
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: center;
    min-height: 32rem;
    padding: clamp(2rem, 4vw, 5rem);
    position: relative;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__banner-title {
    color: inherit;
    font-family: var(--font-heading-family);
    font-size: 16px;
    line-height: 1.08;
    margin: 0;
  }

  #TrendingCollection-{{ section.id }} .trending-collection__banner-description { margin: 1.4rem 0 0; }
  #TrendingCollection-{{ section.id }} .trending-collection__banner-button { margin-top: 2rem; }

  #TrendingCollection-{{ section.id }} .trending-collection__products {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: repeat({{ section.settings.products_to_show }}, minmax(0, 1fr));
  }

  #TrendingCollection-{{ section.id }} .trending-collection__products .grid__item { width: auto; }

  @media screen and (min-width: 750px) {
    #TrendingCollection-{{ section.id }} {
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-top: {{ section.settings.padding_top }}px;
    }
  }

  @media screen and (max-width: 1199px) {
    #TrendingCollection-{{ section.id }} .trending-collection__layout { grid-template-columns: minmax(24rem, 1fr) minmax(0, 2fr); }
    #TrendingCollection-{{ section.id }} .trending-collection__products { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #TrendingCollection-{{ section.id }} .trending-collection__products .grid__item:nth-child(n + 3) { display: none; }
  }

  @media screen and (max-width: 749px) {
    #TrendingCollection-{{ section.id }} .trending-collection__heading-row { align-items: flex-start; flex-direction: column; margin-bottom: 1.8rem; }
    #TrendingCollection-{{ section.id }} .trending-collection__layout { display: flex; flex-direction: column; }
    #TrendingCollection-{{ section.id }} .trending-collection__layout--right .trending-collection__banner,
    #TrendingCollection-{{ section.id }} .trending-collection__layout--right .trending-collection__products { order: initial; }
    #TrendingCollection-{{ section.id }} .trending-collection__banner-content,
    #TrendingCollection-{{ section.id }} .trending-collection__banner-placeholder { min-height: 28rem; }
    #TrendingCollection-{{ section.id }} .trending-collection__banner--has-mobile .trending-collection__banner-image--desktop { display: none; }
    #TrendingCollection-{{ section.id }} .trending-collection__banner-image--mobile { display: block; }
    #TrendingCollection-{{ section.id }} .trending-collection__products { gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
{%- endstyle -%}

<section id="TrendingCollection-{{ section.id }}" class="trending-collection">
  <div class="page-width">
    <div class="trending-collection__heading-row">
      <div>
        {%- if section.settings.title != blank -%}<h2 class="trending-collection__heading">{{ section.settings.title | escape }}</h2>{%- endif -%}
        {%- if section.settings.description != blank -%}<div class="trending-collection__description rte">{{ section.settings.description }}</div>{%- endif -%}
      </div>
      {%- if section.settings.header_button_label != blank -%}
        <a class="button button--secondary trending-collection__header-button" href="{{ section.settings.header_button_link | default: '#' }}">{{ section.settings.header_button_label | escape }}</a>
      {%- endif -%}
    </div>

    <div class="trending-collection__layout trending-collection__layout--{{ section.settings.banner_position }}">
      <div class="trending-collection__banner{% if section.settings.mobile_image != blank %} trending-collection__banner--has-mobile{% endif %}">
        {%- if section.settings.desktop_image != blank -%}
          {{ section.settings.desktop_image | image_url: width: 1600 | image_tag: class: 'trending-collection__banner-image trending-collection__banner-image--desktop', loading: 'lazy', widths: '500, 750, 1000, 1600' }}
        {%- else -%}
          <div class="trending-collection__banner-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endif -%}
        {%- if section.settings.mobile_image != blank -%}
          {{ section.settings.mobile_image | image_url: width: 1000 | image_tag: class: 'trending-collection__banner-image trending-collection__banner-image--mobile', loading: 'lazy', widths: '400, 600, 800, 1000' }}
        {%- endif -%}
        <div class="trending-collection__banner-content">
          {%- if section.settings.banner_title != blank -%}<h3 class="trending-collection__banner-title">{{ section.settings.banner_title | escape }}</h3>{%- endif -%}
          {%- if section.settings.banner_description != blank -%}<div class="trending-collection__banner-description rte">{{ section.settings.banner_description }}</div>{%- endif -%}
          {%- if section.settings.banner_button_label != blank -%}<a class="button trending-collection__banner-button" href="{{ section.settings.banner_button_link | default: '#' }}">{{ section.settings.banner_button_label | escape }}</a>{%- endif -%}
        </div>
      </div>

      <div class="trending-collection__products">
        {%- if section.settings.collection != blank -%}
          {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
            <div class="grid__item">
              {% render 'card-product', card_product: product, media_aspect_ratio: 'square', show_secondary_image: false, show_vendor: false, show_rating: false, quick_add: 'standard', section_id: section.id %}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            <div class="grid__item">{% render 'card-product', placeholder_image: 'product-apparel-' | append: i %}</div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trending collection",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "title", "label": "Section title", "default": "Trending collection" },
    { "type": "richtext", "id": "description", "label": "Section description" },
    { "type": "text", "id": "header_button_label", "label": "Section button label", "default": "View all" },
    { "type": "url", "id": "header_button_link", "label": "Section button link" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 4, "step": 1, "label": "Products to show", "default": 3 },
    { "type": "select", "id": "banner_position", "label": "Banner position", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }] },
    { "type": "header", "content": "Banner content" },
    { "type": "image_picker", "id": "desktop_image", "label": "Banner image (desktop)" },
    { "type": "image_picker", "id": "mobile_image", "label": "Banner image (mobile)" },
    { "type": "text", "id": "banner_title", "label": "Banner title", "default": "Golden Grace Collection" },
    { "type": "richtext", "id": "banner_description", "label": "Banner description", "default": "<p>Crafted to complement your grace.</p>" },
    { "type": "text", "id": "banner_button_label", "label": "Banner button label", "default": "Shop now" },
    { "type": "url", "id": "banner_button_link", "label": "Banner button link" },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "presets": [{ "name": "Trending collection" }]
}
{% endschema %}
