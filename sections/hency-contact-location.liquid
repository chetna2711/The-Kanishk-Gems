{{ 'section-hency-about-contact.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #HencyLocation-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    {%- if section.settings.bg_color != blank -%}
      background-color: {{ section.settings.bg_color }};
    {%- endif -%}
  }

  @media screen and (min-width: 750px) {
    #HencyLocation-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="HencyLocation-{{ section.id }}"
  class="hency-contact-location color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    <div class="hency-location-grid">
      <div class="hency-address-panel">
        <div class="hency-address-panel__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
            <path d="M20 10c0 5.7-8 11-8 11S4 15.7 4 10a8 8 0 1 1 16 0Z"></path>
            <circle cx="12" cy="10" r="2.5"></circle>
          </svg>
        </div>

        {%- if section.settings.eyebrow != blank -%}
          <span class="hency-address-panel__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        <h2 class="hency-address-panel__title">{{ section.settings.heading | escape }}</h2>

        <address>
          {{ section.settings.address_html }}
        </address>

        {%- if section.settings.maps_url != blank -%}
          <div>
            <a
              href="{{ section.settings.maps_url }}"
              target="_blank"
              rel="noopener noreferrer"
              class="hency-btn-primary"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
              </svg>
              <span>{{ section.settings.maps_button_label | default: 'Open in Google Maps' | escape }}</span>
            </a>
          </div>
        {%- endif -%}

        {%- if section.settings.note != blank -%}
          <p class="hency-address-panel__note">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </div>

      <div class="hency-map-frame">
        {%- if section.settings.map_embed_url != blank -%}
          <iframe
            title="{{ section.settings.heading | default: 'HencyJewels Location' | escape }}"
            src="{{ section.settings.map_embed_url }}"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        {%- else -%}
          <iframe
            title="HencyJewels office location on Google Maps"
            src="https://www.google.com/maps?q=Surat%2C%20Gujarat%20395007%2C%20India&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hency Boutique & Map",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "OUR BOUTIQUE & OFFICE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visit HencyJewels"
    },
    {
      "type": "html",
      "id": "address_html",
      "label": "Address (HTML allowed)",
      "default": "HencyJewels Atelier & Studio<br>501, Luxury Arcade, VIP Road<br>Vesu, Surat<br>Gujarat 395007, India"
    },
    {
      "type": "url",
      "id": "maps_url",
      "label": "Google Maps directions link",
      "default": "https://www.google.com/maps"
    },
    {
      "type": "text",
      "id": "maps_button_label",
      "label": "Maps button text",
      "default": "Open in Google Maps"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Assistance note",
      "default": "Please call customer care if you need assistance locating our atelier."
    },
    {
      "type": "textarea",
      "id": "map_embed_url",
      "label": "Google Maps iframe embed URL",
      "info": "Paste the embed URL from Google Maps (src parameter of embed iframe).",
      "default": "https://www.google.com/maps?q=Surat%2C%20Gujarat%20395007%2C%20India&output=embed"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background color (optional)"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Hency Boutique & Map"
    }
  ]
}
{% endschema %}
