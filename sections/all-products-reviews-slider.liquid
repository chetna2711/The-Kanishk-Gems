    border-radius: 50%;
    background: rgba(197, 160, 89, 0.3);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #AllReviewsSlider-{{ section_id }} .ars-dot.is-active {
