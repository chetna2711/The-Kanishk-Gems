    border-radius: 1rem;
    background: var(--ars-gold);
  }

  /* Loading Spinner */
  .ars-spinner {
    width: 3.2rem;
    height: 3.2rem;
    border: 3px solid rgba(197, 160, 89, 0.25);
    border-top-color: var(--ars-gold);
