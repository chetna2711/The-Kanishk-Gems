<!-- JavaScript Carousel Controller -->
<script>
  (function () {
    const root = document.getElementById('AllReviewsSlider-{{ section_id }}');
    if (!root) return;

    const viewport = root.querySelector('[data-ars-viewport]');
    const track = root.querySelector('[data-ars-track]');
    const prevBtns = root.querySelectorAll('[data-ars-prev]');
    const nextBtns = root.querySelectorAll('[data-ars-next]');
    const dotsContainer = root.querySelector('[data-ars-dots]');

    const webhookUrl = root.dataset.webhookUrl;
    const isAutoplay = root.dataset.autoplay === 'true';
    const autoplaySpeed = parseInt(root.dataset.autoplaySpeed || 5, 10) * 1000;
    const pauseOnHover = root.dataset.pauseOnHover === 'true';
    const showProductBadge = root.dataset.showProductBadge === 'true';
    const showPhotos = root.dataset.showPhotos === 'true';
    const showVerified = root.dataset.showVerified === 'true';

    // 1. Gather reviews from Product Metafields and Blocks
    let reviewsList = [];

    try {
      const prodMfRaw = document.getElementById('ArsProductReviews-{{ section_id }}').textContent.trim();
      if (prodMfRaw) {
        const parsed = JSON.parse(prodMfRaw);
        if (Array.isArray(parsed)) reviewsList = reviewsList.concat(parsed);
      }
    } catch (e) {}

    try {
      const blockRaw = document.getElementById('ArsBlockReviews-{{ section_id }}').textContent.trim();
      if (blockRaw) {
        const parsedB = JSON.parse(blockRaw);
        if (Array.isArray(parsedB)) reviewsList = reviewsList.concat(parsedB);
      }
    } catch (e) {}

    // Fallback luxury reviews if none found yet
    const fallbackReviews = [
      {
        id: 'fb_1',
        author: 'Minu',
        location: 'Baroda',
        rating: 5,
        title: 'Good Product',
        content: 'The Bracelet is so pretty.Good quality finish and the packaging made it feel like a fine luxury gift.',
        photos: ['https://lh3.googleusercontent.com/d/1raw10a4pFhsiSafzESxSe_2aaxfNtgtZ=w1000'],
        productTitle: 'Noir Beaded Bracelet',
        productUrl: '/products/bracelet-6',
        productImage: 'https://cdn.shopify.com/s/files/1/0850/0376/3960/files/7-1_105eb7a1-ebe8-4ce3-9561-8a158918436d.jpg?v=1792045075'
      },
      {
        id: 'fb_2',
        author: 'Krishna kanika',
        location: 'Pune',
        rating: 5,
        title: 'Lovely nackless set very good quality',
        content: 'Product quality badhiya hai must set hai',
        photos: ['https://lh3.googleusercontent.com/d/1FhkHaJ41jKIWxodeX9NLvcV8wlyLj0By=w1000'],
        productTitle: 'Royal Blue Emerald-Cut Crystal Necklace and Earring Set',
        productUrl: '/products/necklace-set-6',
        productImage: 'https://cdn.shopify.com/s/files/1/0850/0376/3960/files/8-1_5817fe09-b015-409d-ac18-ce09b16fabee.jpg?v=1793166060'
      },
      {
        id: 'fb_3',
        author: 'Nirali Gohil',
        location: 'Ahemdabad',
        rating: 5,
        title: 'Really Good Necklace',
        content: 'The Necklace is really beautiful.',
        photos: ['https://lh3.googleusercontent.com/d/19qtzTRbLpCJ_A8UB5Qdvkb_P2mEBrIrJ=w1000'],
        productTitle: 'Gold Square Red Gemstone Necklace',
        productUrl: '/products/necklace-6',
        productImage: 'https://cdn.shopify.com/s/files/1/0850/0376/3960/files/7-4_f10a9c14-d8b7-4290-8763-be08133dc805.jpg?v=1791877453'
      },
      {
        id: 'fb_4',
        author: 'Asmita',
        location: 'Mumbai',
        rating: 5,
        title: 'Very good product',
        content: 'Awesome product with elegant gold filigree finish.',
        photos: ['https://lh3.googleusercontent.com/d/1JHdYpeI4UnVqPDIGUfdH0MeHqbOPn2hE=w1000'],
        productTitle: 'Gold Filigree Mangalsutra with Black Beads',
        productUrl: '/products/mangalsutra-25',
        productImage: 'https://cdn.shopify.com/s/files/1/0850/0376/3960/files/23-1.jpg?v=1791799643'
      },
      {
        id: 'fb_5',
        author: 'Chetna Kanak',
        location: 'Surat',
        rating: 5,
        title: 'Statement Necklace Sets',
        content: 'Elegant necklace sets designed to add the perfect finishing touch to every occasion.',
        photos: ['https://lh3.googleusercontent.com/d/1UXyjt_6B-7-U2KXEfrAbPvVSVTQrkSBV=w1000'],
        productTitle: 'Oval Halo Gemstone Necklace & Earrings Set',
        productUrl: '/products/jewellery-set-8',
        productImage: 'https://cdn.shopify.com/s/files/1/0850/0376/3960/files/GoldenOvalGemstoneJewellerySet.png?v=1791698290'
      }
    ];

    if (reviewsList.length === 0) {
      reviewsList = fallbackReviews;
    }

    // Deduplicate reviews
    const seen = new Set();
    reviewsList = reviewsList.filter(r => {
      const k = r.id || (r.author + '_' + (r.title || '') + '_' + (r.content || ''));
      if (seen.has(k)) return false;
      seen.add(k);
      return true;
    });

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function renderStars(rating) {
      const r = Math.min(5, Math.max(1, parseInt(rating || 5, 10)));
      let out = '<div class="ars-stars-wrap" aria-label="' + r + ' out of 5 stars">';
      for (let i = 1; i <= 5; i++) {
        const isFilled = i <= r;
        out += `<svg class="ars-star-svg ${isFilled ? '' : 'ars-star-svg--empty'}" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>`;
      }
      out += '</div>';
      return out;
    }

    function renderSlide(rev) {
      const initial = (rev.author || 'V').trim().charAt(0).toUpperCase();
      const firstPhoto = (showPhotos && rev.photos && Array.isArray(rev.photos) && rev.photos.length > 0)
        ? rev.photos[0]
        : (rev.productImage || '');

      let photoColHtml = '';
      if (firstPhoto) {
        photoColHtml = `
          <div class="ars-card__photo-col">
            <div class="ars-card__photo-frame" title="${escapeHtml(rev.author || 'Reviewer')} styling photo">
              <img src="${escapeHtml(firstPhoto)}" alt="${escapeHtml(rev.author || 'Reviewer')} styling photo" loading="lazy">
            </div>
          </div>
        `;
      }

      let productBadgeHtml = '';
      if (showProductBadge && rev.productTitle) {
        const pImg = rev.productImage || '';
        productBadgeHtml = `
          <a href="${escapeHtml(rev.productUrl || '#')}" class="ars-product-row" title="View ${escapeHtml(rev.productTitle)}">
            ${pImg ? `<img src="${escapeHtml(pImg)}" class="ars-product-img" alt="${escapeHtml(rev.productTitle)}" loading="lazy">` : ''}
            <div class="ars-product-info">
              <p class="ars-product-title">${escapeHtml(rev.productTitle)}</p>
              <div class="ars-product-btn-text">
                <span>View Product</span>
                <svg class="ars-product-btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </div>
          </a>
        `;
      }

      return `
        <div class="ars-slide" role="group" aria-roledescription="slide">
          <div class="ars-card">
            ${photoColHtml}
            <div class="ars-card__content-col">
              <div>
                <div class="ars-card__header-row">
                  <div class="ars-card__author-group">
                    <div class="ars-avatar">
                      ${rev.avatar ? `<img src="${escapeHtml(rev.avatar)}" alt="${escapeHtml(rev.author)}">` : initial}
                    </div>
                    <div class="ars-card__author-text">
                      <p class="ars-card__name">${escapeHtml(rev.author || 'Customer')}</p>
                      ${rev.location ? `<p class="ars-card__location">${escapeHtml(rev.location)}</p>` : ''}
                    </div>
                  </div>

                  <div class="ars-card__quote-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                    </svg>
                  </div>
                </div>

                ${renderStars(rev.rating)}

                ${rev.title ? `<h3 class="ars-card__headline">${escapeHtml(rev.title)}</h3>` : ''}
                <p class="ars-card__text">${escapeHtml(rev.content || '')}</p>
              </div>

              ${productBadgeHtml}
            </div>
          </div>
        </div>
      `;
    }

    function initSlider() {
      track.innerHTML = reviewsList.map(renderSlide).join('');
      buildDots();
      updateNavigation();
    }

    // Dots & Pagination Calculation
    function getSlidesVisible() {
      if (window.innerWidth <= 749) {
        return parseInt(root.dataset.columnsMobile || 1, 10);
      } else if (window.innerWidth <= 989) {
        return 2;
      }
      return parseInt(root.dataset.columnsDesktop || 3, 10);
    }

    function buildDots() {
      if (!dotsContainer) return;
      dotsContainer.innerHTML = '';
      const slides = track.querySelectorAll('.ars-slide');
      const totalSlides = slides.length;
      const visible = getSlidesVisible();
      const dotCount = Math.max(1, totalSlides - visible + 1);

      if (dotCount <= 1) {
        dotsContainer.style.display = 'none';
        return;
      }
      dotsContainer.style.display = 'flex';

      for (let i = 0; i < dotCount; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'ars-dot' + (i === 0 ? ' is-active' : '');
        dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
        dot.addEventListener('click', () => scrollToSlide(i));
        dotsContainer.appendChild(dot);
      }
    }

    function updateActiveDot(index) {
      if (!dotsContainer) return;
      const dots = dotsContainer.querySelectorAll('.ars-dot');
      dots.forEach((d, idx) => {
        if (idx === index) d.classList.add('is-active');
        else d.classList.remove('is-active');
      });
    }

    function scrollToSlide(index) {
      const slides = track.querySelectorAll('.ars-slide');
      if (!slides[index]) return;
      const targetLeft = slides[index].offsetLeft;
      viewport.scrollTo({
        left: targetLeft,
        behavior: 'smooth'
      });
      updateActiveDot(index);
    }

    function updateNavigation() {
      const maxScrollLeft = viewport.scrollWidth - viewport.clientWidth;
      const currentScroll = viewport.scrollLeft;

      prevBtns.forEach(btn => {
        btn.disabled = currentScroll <= 4;
      });
      nextBtns.forEach(btn => {
        btn.disabled = currentScroll >= maxScrollLeft - 4;
      });

      // Update dot based on scroll position
      const slides = track.querySelectorAll('.ars-slide');
      if (slides.length > 0) {
        let closestIdx = 0;
        let minDiff = Infinity;
        slides.forEach((s, idx) => {
          const diff = Math.abs(s.offsetLeft - currentScroll);
          if (diff < minDiff) {
            minDiff = diff;
            closestIdx = idx;
          }
        });
        updateActiveDot(closestIdx);
      }
    }

    // Button event listeners
    prevBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const slides = track.querySelectorAll('.ars-slide');
        if (slides.length === 0) return;
        const slideWidth = slides[0].offsetWidth + parseInt(root.style.getPropertyValue('--ars-gap') || 20, 10);
        viewport.scrollBy({ left: -slideWidth, behavior: 'smooth' });
      });
    });

    nextBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const slides = track.querySelectorAll('.ars-slide');
        if (slides.length === 0) return;
        const slideWidth = slides[0].offsetWidth + parseInt(root.style.getPropertyValue('--ars-gap') || 20, 10);
        const maxScrollLeft = viewport.scrollWidth - viewport.clientWidth;
        if (viewport.scrollLeft >= maxScrollLeft - 10) {
          viewport.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          viewport.scrollBy({ left: slideWidth, behavior: 'smooth' });
        }
      });
    });

    viewport.addEventListener('scroll', () => {
      requestAnimationFrame(updateNavigation);
    }, { passive: true });

    window.addEventListener('resize', () => {
      buildDots();
      updateNavigation();
    });

    // Touch & Mouse Drag to scroll
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    viewport.addEventListener('mousedown', (e) => {
      isDown = true;
      viewport.classList.add('is-dragging');
      startX = e.pageX - viewport.offsetLeft;
      scrollLeft = viewport.scrollLeft;
    });

    viewport.addEventListener('mouseleave', () => {
      isDown = false;
      viewport.classList.remove('is-dragging');
    });

    viewport.addEventListener('mouseup', () => {
      isDown = false;
      viewport.classList.remove('is-dragging');
    });

    viewport.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - viewport.offsetLeft;
      const walk = (x - startX) * 1.5;
      viewport.scrollLeft = scrollLeft - walk;
    });

    // Autoplay Timer
    let autoplayTimer = null;
    function startAutoplay() {
      if (!isAutoplay || autoplayTimer) return;
      autoplayTimer = setInterval(() => {
        const maxScrollLeft = viewport.scrollWidth - viewport.clientWidth;
        const slides = track.querySelectorAll('.ars-slide');
        if (slides.length === 0) return;
        const slideWidth = slides[0].offsetWidth + parseInt(root.style.getPropertyValue('--ars-gap') || 20, 10);

        if (viewport.scrollLeft >= maxScrollLeft - 10) {
          viewport.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          viewport.scrollBy({ left: slideWidth, behavior: 'smooth' });
        }
      }, autoplaySpeed);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    if (isAutoplay) {
      startAutoplay();
      if (pauseOnHover) {
        root.addEventListener('mouseenter', stopAutoplay);
        root.addEventListener('mouseleave', startAutoplay);
        root.addEventListener('touchstart', stopAutoplay, { passive: true });
        root.addEventListener('touchend', startAutoplay, { passive: true });
      }
    }

    // Initial render
    initSlider();

    // 2. Fetch live reviews from Cloud Webhook (if URL configured)
    if (webhookUrl && webhookUrl.startsWith('http')) {
      const knownReviewedProductIds = [
        '15453389095160',
        '15417808912632',
        '15411589742840',
        '15408898343160',
        '15405932675320'
      ];

      async function fetchAllSliderReviews() {
        try {
          let cloudReviews = [];
          // 1. Try global getReviews
          const fetchUrl = webhookUrl + (webhookUrl.includes('?') ? '&' : '?') + 'action=getReviews&all=1';
          try {
            const res = await fetch(fetchUrl);
            const data = await res.json();
            if (Array.isArray(data) && data.length > 0) {
              cloudReviews = data;
            }
          } catch (e) {}

          // 2. If empty, parallel fetch all known products with reviews
          if (cloudReviews.length === 0) {
            const responses = await Promise.all(
              knownReviewedProductIds.map(pid =>
                fetch(webhookUrl + (webhookUrl.includes('?') ? '&' : '?') + 'action=getReviews&productId=' + encodeURIComponent(pid))
                  .then(r => r.json())
                  .catch(() => [])
              )
            );
            responses.forEach(arr => {
              if (Array.isArray(arr)) cloudReviews = cloudReviews.concat(arr);
            });
          }

          const productMetaMap = {
            '15453389095160': {
              title: 'Royal Blue Emerald-Cut Crystal Necklace and Earring Set',
              handle: 'necklace-set-6',
              image: 'https://cdn.shopify.com/s/files/1/0850/0376/3960/files/8-1_5817fe09-b015-409d-ac18-ce09b16fabee.jpg?v=1793166060'
            },
            '15417808912632': {
              title: 'Noir Beaded Bracelet',
              handle: 'bracelet-6',
              image: 'https://cdn.shopify.com/s/files/1/0850/0376/3960/files/7-1_105eb7a1-ebe8-4ce3-9561-8a158918436d.jpg?v=1792045075'
            },
            '15411589742840': {
              title: 'Gold Square Red Gemstone Necklace',
              handle: 'necklace-6',
              image: 'https://cdn.shopify.com/s/files/1/0850/0376/3960/files/7-4_f10a9c14-d8b7-4290-8763-be08133dc805.jpg?v=1791877453'
            },
            '15408898343160': {
              title: 'Gold Filigree Mangalsutra with Black Beads',
              handle: 'mangalsutra-25',
              image: 'https://cdn.shopify.com/s/files/1/0850/0376/3960/files/23-1.jpg?v=1791799643'
            },
            '15405932675320': {
              title: 'Oval Halo Gemstone Necklace & Earrings Set',
              handle: 'jewellery-set-8',
              image: 'https://cdn.shopify.com/s/files/1/0850/0376/3960/files/GoldenOvalGemstoneJewellerySet.png?v=1791698290'
            }
          };

          if (Array.isArray(cloudReviews) && cloudReviews.length > 0) {
            // Attach product info to each review
            cloudReviews.forEach(r => {
              if (r.productId && productMetaMap[r.productId]) {
                const meta = productMetaMap[r.productId];
                r.productTitle = r.productTitle || meta.title;
                r.productUrl = r.productUrl || ('/products/' + meta.handle);
                r.productImage = r.productImage || meta.image;
              }
            });

            // Real reviews exist: remove dummy fallback reviews starting with fb_
            const metaAndBlocks = reviewsList.filter(r => !String(r.id || '').startsWith('fb_'));
            const combined = [...cloudReviews, ...metaAndBlocks];
            const dedupedSeen = new Set();
            reviewsList = combined.filter(r => {
              if (!r) return false;
              if (r.status && r.status !== 'approved') return false;
              const k = r.id || (r.author + '_' + (r.title || '') + '_' + (r.content || ''));
              if (dedupedSeen.has(k)) return false;
              dedupedSeen.add(k);
              return true;
            });
            initSlider();
          }
        } catch (err) {
          console.warn('[AllReviewsSlider] Cloud fetch notice:', err);
        }
      }

      fetchAllSliderReviews();
    }
  })();
</script>

