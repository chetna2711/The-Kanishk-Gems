{%- style -%}
  #OffersDiscounts-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    {%- if section.settings.section_bg_color != blank -%}
      background-color: {{ section.settings.section_bg_color }};
    {%- endif -%}
  }

  @media screen and (min-width: 750px) {
    #OffersDiscounts-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__container {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media screen and (min-width: 750px) {
    #OffersDiscounts-{{ section.id }} .offers-discounts__container {
      padding: 0 5rem;
    }
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__header {
    margin-bottom: 2.8rem;
    {%- if section.settings.heading_align == 'left' -%}
      text-align: left;
    {%- elsif section.settings.heading_align == 'right' -%}
      text-align: right;
    {%- else -%}
      text-align: center;
    {%- endif -%}
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__title {
    margin: 0;
    font-family: var(--font-heading-family);
    color: var(--color-foreground, #1a1a1a);
    line-height: 1.25;
    {%- case section.settings.heading_size -%}
      {%- when 'small' -%}
        font-size: clamp(2rem, 2.5vw, 2.6rem);
      {%- when 'medium' -%}
        font-size: clamp(2.4rem, 3.2vw, 3.4rem);
      {%- when 'large' -%}
        font-size: clamp(2.8rem, 4vw, 4.2rem);
      {%- else -%}
        font-size: clamp(2.4rem, 3.2vw, 3.4rem);
    {%- endcase -%}
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__description {
    margin: 0.8rem 0 0;
    color: rgba(var(--color-foreground, 26, 26, 26), 0.75);
    font-size: 1.5rem;
    line-height: 1.5;
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    #OffersDiscounts-{{ section.id }} .offers-discounts__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 2 }}, 1fr);
      gap: 2.8rem;
    }
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__card {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__card-header {
    margin-bottom: 1.2rem;
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__card-title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 2vw, 2.2rem);
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__card-subtitle {
    margin: 0.4rem 0 0;
    font-size: 1.4rem;
    color: rgba(var(--color-foreground, 26, 26, 26), 0.7);
    line-height: 1.4;
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__media-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.card_border_radius | default: 16 }}px;
    background-color: #f2f2f2;
    {%- case section.settings.card_aspect_ratio -%}
      {%- when '16_9' -%}
        aspect-ratio: 16 / 9;
      {%- when '4_3' -%}
        aspect-ratio: 4 / 3;
      {%- when '3_2' -%}
        aspect-ratio: 3 / 2;
      {%- when '1_1' -%}
        aspect-ratio: 1 / 1;
      {%- when '2_1' -%}
        aspect-ratio: 2 / 1;
      {%- else -%}
        aspect-ratio: 16 / 9;
    {%- endcase -%}
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__card:hover .offers-discounts__img {
    transform: scale(1.03);
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__img--mobile {
    display: block;
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__img--desktop {
    display: none;
  }

  @media screen and (min-width: 750px) {
    #OffersDiscounts-{{ section.id }} .offers-discounts__img--mobile {
      display: none;
    }
    #OffersDiscounts-{{ section.id }} .offers-discounts__img--desktop {
      display: block;
    }
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__btn-bar {
    position: absolute;
    bottom: 1.6rem;
    left: 0;
    right: 0;
    padding: 0 1.8rem;
    display: flex;
    z-index: 2;
    pointer-events: none;
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__btn-bar--left {
    justify-content: flex-start;
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__btn-bar--center {
    justify-content: center;
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__btn-bar--right {
    justify-content: flex-end;
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__pill-btn {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background-color: #111111;
    color: #ffffff;
    font-size: 1.35rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 9999px;
    padding: 0.85rem 2.2rem;
    line-height: 1;
    transition: background-color 0.25s ease, transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__pill-btn:hover {
    background-color: #000000;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
    color: #ffffff;
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__pill-btn svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: currentColor;
    transition: transform 0.2s ease;
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__pill-btn:hover svg {
    transform: translateX(3px);
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__placeholder {
    width: 100%;
    height: 100%;
    background-color: #eaeaea;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #OffersDiscounts-{{ section.id }} .offers-discounts__placeholder svg {
    width: 35%;
    height: 35%;
    opacity: 0.45;
  }
{%- endstyle -%}

<div id="OffersDiscounts-{{ section.id }}" class="offers-discounts section-{{ section.id }}">
  <div class="offers-discounts__container">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="offers-discounts__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="offers-discounts__title">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="offers-discounts__description rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="offers-discounts__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign target_url = block.settings.button_link | default: block.settings.link
            assign img_desktop = block.settings.image_desktop
            assign img_mobile = block.settings.image_mobile | default: img_desktop
          -%}

          <div class="offers-discounts__card" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank or block.settings.description != blank -%}
              <div
                class="offers-discounts__card-header"
                style="text-align: {{ block.settings.heading_align | default: 'center' }};"
              >
                {%- if block.settings.heading != blank -%}
                  <h3
                    class="offers-discounts__card-title"
                    style="color: {{ block.settings.heading_color | default: '#8B1D40' }};"
                  >
                    {{ block.settings.heading }}
                  </h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <div
                    class="offers-discounts__card-subtitle"
                    style="text-align: {{ block.settings.heading_align | default: 'center' }};"
                  >
                    {{ block.settings.description }}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="offers-discounts__media-wrap">
              {%- if target_url != blank -%}
                <a href="{{ target_url }}" class="offers-discounts__card-link" aria-label="{{ block.settings.heading | default: block.settings.button_label | escape }}">
              {%- endif -%}

              {%- if img_desktop != blank -%}
                {%- if block.settings.image_mobile != blank -%}
                  <img
                    srcset="
                      {%- if img_mobile.width >= 375 -%}{{ img_mobile | image_url: width: 375 }} 375w,{%- endif -%}
                      {%- if img_mobile.width >= 550 -%}{{ img_mobile | image_url: width: 550 }} 550w,{%- endif -%}
                      {%- if img_mobile.width >= 750 -%}{{ img_mobile | image_url: width: 750 }} 750w{%- endif -%}
                    "
                    src="{{ img_mobile | image_url: width: 750 }}"
                    sizes="100vw"
                    alt="{{ img_mobile.alt | default: block.settings.heading | escape }}"
                    class="offers-discounts__img offers-discounts__img--mobile"
                    loading="lazy"
                    width="{{ img_mobile.width }}"
                    height="{{ img_mobile.height }}"
                  >
                {%- endif -%}

                <img
                  srcset="
                    {%- if img_desktop.width >= 550 -%}{{ img_desktop | image_url: width: 550 }} 550w,{%- endif -%}
                    {%- if img_desktop.width >= 750 -%}{{ img_desktop | image_url: width: 750 }} 750w,{%- endif -%}
                    {%- if img_desktop.width >= 1100 -%}{{ img_desktop | image_url: width: 1100 }} 1100w,{%- endif -%}
                    {%- if img_desktop.width >= 1500 -%}{{ img_desktop | image_url: width: 1500 }} 1500w{%- endif -%}
                  "
                  src="{{ img_desktop | image_url: width: 1100 }}"
                  sizes="(min-width: 750px) 50vw, 100vw"
                  alt="{{ img_desktop.alt | default: block.settings.heading | escape }}"
                  class="offers-discounts__img {% if block.settings.image_mobile != blank %}offers-discounts__img--desktop{% endif %}"
                  loading="lazy"
                  width="{{ img_desktop.width }}"
                  height="{{ img_desktop.height }}"
                >
              {%- else -%}
                <div class="offers-discounts__placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}

              {%- if target_url != blank -%}
                </a>
              {%- endif -%}

              {%- if block.settings.button_label != blank -%}
                <div class="offers-discounts__btn-bar offers-discounts__btn-bar--{{ block.settings.button_align | default: 'center' }}">
                  <a
                    href="{{ target_url | default: '#' }}"
                    class="offers-discounts__pill-btn"
                    {% if block.settings.button_bg_color != blank or block.settings.button_text_color != blank %}
                      style="
                        {%- if block.settings.button_bg_color != blank -%}background-color: {{ block.settings.button_bg_color }};{%- endif -%}
                        {%- if block.settings.button_text_color != blank -%}color: {{ block.settings.button_text_color }};{%- endif -%}
                      "
                    {% endif %}
                  >
                    <span>{{ block.settings.button_label | escape }}</span>
                    {%- if block.settings.show_arrow -%}
                      <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M1 7H13M13 7L7.5 1.5M13 7L7.5 12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- endif -%}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Offers And Discounts",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Offers And Discounts"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Section Description"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "Cards per row (Desktop)"
    },
    {
      "type": "select",
      "id": "card_aspect_ratio",
      "label": "Card Aspect Ratio",
      "options": [
        {
          "value": "16_9",
          "label": "16:9 (Wide)"
        },
        {
          "value": "4_3",
          "label": "4:3 (Standard)"
        },
        {
          "value": "3_2",
          "label": "3:2 (Classic)"
        },
        {
          "value": "1_1",
          "label": "1:1 (Square)"
        },
        {
          "value": "2_1",
          "label": "2:1 (Panoramic)"
        }
      ],
      "default": "16_9"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 16
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color"
    },
    {
      "type": "header",
      "content": "Padding Desktop"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 48
    },
    {
      "type": "header",
      "content": "Padding Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "offer_card",
      "name": "Offer Card",
      "settings": [
        {
          "type": "header",
          "content": "Offer Heading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Card Heading",
          "default": "FLAT ₹999"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading Color",
          "default": "#8B1D40"
        },
        {
          "type": "select",
          "id": "heading_align",
          "label": "Heading Alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Card Description (Optional)"
        },
        {
          "type": "header",
          "content": "Images"
        },
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Image (Optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link (Overrides Card Link)"
        },
        {
          "type": "select",
          "id": "button_align",
          "label": "Button Alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        },
        {
          "type": "checkbox",
          "id": "show_arrow",
          "label": "Show Arrow Icon",
          "default": true
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "Button Background Color"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button Text Color"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Offers And Discounts",
      "blocks": [
        {
          "type": "offer_card",
          "settings": {
            "heading": "FLAT ₹999",
            "heading_color": "#8B1D40",
            "heading_align": "center",
            "button_label": "Explore",
            "button_align": "center",
            "show_arrow": true
          }
        },
        {
          "type": "offer_card",
          "settings": {
            "heading": "BUY 1 GET 1 FREE",
            "heading_color": "#8B1D40",
            "heading_align": "center",
            "button_label": "Explore",
            "button_align": "center",
            "show_arrow": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
