{%- style -%}
  #ShopByCategory-{{ section.id }} {
    --category-accent: var(--brand-primary);
    --category-title-color: var(--brand-text);
    --category-text-color: var(--brand-text);
    background: var(--brand-background);
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__header {
    max-width: 76rem;
    margin: 0 auto 3.2rem;
    text-align: center;
  }
  #ShopByCategory-{{ section.id }} .shop-by-category__sparkle {
    font-size: 2.6rem;
    line-height: 1;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__title {
    color: var(--category-title-color);
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 25px;
    font-weight: var(--font-heading-weight);
    line-height: 1.15;
    text-transform: uppercase;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__description {
    color: var(--category-text-color);
    margin: 1.5rem auto 0;
    max-width: 62rem;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__button {
    margin-top: 2rem;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__slider {
    overflow: hidden;
    padding: .5rem .2rem 1.5rem;
    position: relative;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__item {
    min-width: 0;
    text-align: center;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__link {
    color: var(--category-title-color);
    display: block;
    text-decoration: none;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__image-wrap {
    aspect-ratio: 1;
    border: 1px solid var(--category-accent);
    border-radius: 50%;
    padding: .7rem;
    position: relative;
    transition: transform .25s ease, box-shadow .25s ease;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__image-wrap::after {
    background: var(--brand-background);
    bottom: -.9rem;
    color: var(--category-accent);
    content: '✦';
    font-size: 2.1rem;
    left: 50%;
    line-height: 1;
    padding: 0 .45rem;
    position: absolute;
    transform: translateX(-50%);
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__image {
    background: var(--brand-cream);
    border-radius: 50%;
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__placeholder {
    align-items: center;
    background: rgba(var(--color-foreground), .06);
    border-radius: 50%;
    color: rgba(var(--color-foreground), .45);
    display: flex;
    height: 100%;
    justify-content: center;
    width: 100%;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__name {
    color: var(--category-title-color);
    font-family: var(--font-heading-family);
    font-size: 16px;
    font-weight: var(--font-heading-weight);
    line-height: 1.2;
    margin: 2.2rem 0 0;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__link:hover .shop-by-category__image-wrap {
    box-shadow: 0 .6rem 1.8rem rgba(0, 0, 0, .12);
    transform: translateY(-.5rem);
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__navigation {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__navigation[hidden] {
    display: none;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__arrow {
    align-items: center;
    background: var(--brand-background);
    border: 1px solid var(--brand-border);
    border-radius: 50%;
    color: var(--brand-primary);
    cursor: pointer;
    display: flex;
    height: 4.2rem;
    justify-content: center;
    transition: background .2s ease, color .2s ease;
    width: 4.2rem;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__arrow:hover:not(.swiper-button-disabled) {
    background: var(--brand-primary);
    color: var(--brand-background);
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__arrow.swiper-button-disabled {
    cursor: default;
    opacity: .35;
  }

  @media screen and (min-width: 750px) {
    #ShopByCategory-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }

  @media screen and (max-width: 749px) {
    #ShopByCategory-{{ section.id }} .shop-by-category__header { margin-bottom: 2.5rem; }
    #ShopByCategory-{{ section.id }} .shop-by-category__title { font-size:18px; }
    #ShopByCategory-{{ section.id }} .shop-by-category__name { font-size: 14px; }
    #ShopByCategory-{{ section.id }} .shop-by-category__navigation { display: none; }
  }
{%- endstyle -%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer="defer"></script>

<section id="ShopByCategory-{{ section.id }}" class="shop-by-category">
  <div class="page-width">
    <div class="shop-by-category__header">
      {%- if section.settings.title != blank -%}
        <h2 class="shop-by-category__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="shop-by-category__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
      {%- if section.settings.button_text != blank -%}
        <a class="button shop-by-category__button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_text | escape }}</a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="shop-by-category__slider swiper" data-category-swiper>
        <ul class="shop-by-category__list swiper-wrapper" role="list">
          {%- for block in section.blocks -%}
            <li class="shop-by-category__item swiper-slide" {{ block.shopify_attributes }}>
              <a class="shop-by-category__link" href="{{ block.settings.link | default: '#' }}">
                <div class="shop-by-category__image-wrap">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 700 | image_tag: class: 'shop-by-category__image', loading: 'lazy', widths: '180, 260, 360, 520, 700', alt: block.settings.image.alt | default: block.settings.title }}
                  {%- else -%}
                    <div class="shop-by-category__placeholder">{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                  {%- endif -%}
                </div>
                {%- if block.settings.title != blank -%}<h3 class="shop-by-category__name">{{ block.settings.title | escape }}</h3>{%- endif -%}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
      <div class="shop-by-category__navigation" aria-label="Category carousel controls">
        <button class="shop-by-category__arrow shop-by-category__arrow--previous" type="button" aria-label="Previous categories">←</button>
        <button class="shop-by-category__arrow shop-by-category__arrow--next" type="button" aria-label="Next categories">→</button>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const sectionId = 'ShopByCategory-{{ section.id }}';
    const initialiseSwiper = () => {
      const section = document.getElementById(sectionId);
      const slider = section && section.querySelector('[data-category-swiper]');
      if (!slider || !window.Swiper || slider.swiper) return;
      const navigation = section.querySelector('.shop-by-category__navigation');
      const updateNavigationVisibility = (swiper) => {
        if (navigation) navigation.hidden = swiper.isLocked;
      };

      const swiper = new Swiper(slider, {
        slidesPerView: 3,
        spaceBetween: 12,
        watchOverflow: true,
        navigation: {
          nextEl: section.querySelector('.shop-by-category__arrow--next'),
          prevEl: section.querySelector('.shop-by-category__arrow--previous')
        },
        breakpoints: {
          768: { slidesPerView: 4, spaceBetween: 18 },
          1024: { slidesPerView: 6, spaceBetween: 26 },
          1440: { slidesPerView: 7, spaceBetween: 32 }
        },
        on: {
          init: updateNavigationVisibility,
          resize: updateNavigationVisibility,
          update: updateNavigationVisibility
        }
      });

      updateNavigationVisibility(swiper);
    };

    document.addEventListener('DOMContentLoaded', initialiseSwiper);
    window.addEventListener('load', initialiseSwiper);
    document.addEventListener('shopify:section:load', (event) => {
      if (event.target.id === sectionId || (event.target.querySelector && event.target.querySelector('#' + sectionId))) initialiseSwiper();
    });
  })();
</script>

{% schema %}
{
  "name": "Shop by category circles",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Shop by category" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "text", "id": "button_text", "label": "Button text" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Category image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Category name" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category circles",
      "blocks": [
        { "type": "category", "settings": { "title": "Bangles" } },
        { "type": "category", "settings": { "title": "Mangalsutra" } },
        { "type": "category", "settings": { "title": "Earrings" } },
        { "type": "category", "settings": { "title": "Gold chains" } }
      ]
    }
  ]
}
{% endschema %}
