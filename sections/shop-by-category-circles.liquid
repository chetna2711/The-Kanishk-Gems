{%- style -%}
  #ShopByCategory-{{ section.id }} {
    background: var(--hency-ivory, #fafaf7);
    padding-top: calc(var(--spacing-sections-mobile, 0px));
    padding-bottom: calc(var(--spacing-sections-mobile, 0px));
  }

  @media screen and (min-width: 750px) {
    #ShopByCategory-{{ section.id }} {
      padding-top: calc(var(--spacing-sections-desktop, 0px));
      padding-bottom: calc(var(--spacing-sections-desktop, 0px));
    }
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__header {
    max-width: 72rem;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__eyebrow {
    color: var(--hency-gold, #c5a059);
    font-size: 1.2rem;
    letter-spacing: 0.25rem;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 0.8rem;
    display: block;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__title {
    color: var(--hency-charcoal, #1a1a1a);
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 3.5vw, 3.6rem);
    font-weight: var(--font-heading-weight, 500);
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__description {
    color: rgba(26, 26, 26, 0.75);
    margin: 1.2rem auto 0;
    font-size: 1.5rem;
    line-height: 1.5;
    max-width: 60rem;
  }

  /* Slider Container */
  #ShopByCategory-{{ section.id }} .shop-by-category__slider-wrapper {
    position: relative;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__slider {
    display: flex;
    gap: 1.8rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: 1rem 0.5rem 2rem;
    scrollbar-width: none;
  }
  #ShopByCategory-{{ section.id }} .shop-by-category__slider::-webkit-scrollbar {
    display: none;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__item {
    flex: 0 0 calc((100% - 2 * 1.8rem) / 3);
    min-width: 11rem;
    scroll-snap-align: start;
    text-align: center;
    list-style: none;
  }

  @media screen and (min-width: 600px) {
    #ShopByCategory-{{ section.id }} .shop-by-category__item {
      flex: 0 0 calc((100% - 3 * 1.8rem) / 4);
    }
  }

  @media screen and (min-width: 990px) {
    #ShopByCategory-{{ section.id }} .shop-by-category__item {
      flex: 0 0 calc((100% - 5 * 2.2rem) / 6);
      gap: 2.2rem;
    }
  }

  @media screen and (min-width: 1200px) {
    #ShopByCategory-{{ section.id }} .shop-by-category__item {
      flex: 0 0 calc((100% - 6 * 2.4rem) / 7);
    }
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__link {
    color: var(--hency-charcoal, #1a1a1a);
    display: block;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__image-wrap {
    aspect-ratio: 1;
    border: 1px solid var(--hency-gold, #c5a059);
    border-radius: 50%;
    padding: 0.6rem;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    background: #ffffff;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__image-wrap::after {
    background: var(--hency-ivory, #fafaf7);
    bottom: -0.9rem;
    color: var(--hency-gold, #c5a059);
    content: '✦';
    font-size: 1.8rem;
    left: 50%;
    line-height: 1;
    padding: 0 0.4rem;
    position: absolute;
    transform: translateX(-50%);
    transition: transform 0.3s ease;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__image {
    background: var(--hency-cream, #f6f3ed);
    border-radius: 50%;
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
    transition: transform 0.4s ease;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__placeholder {
    align-items: center;
    background: var(--hency-cream, #f6f3ed);
    border-radius: 50%;
    color: var(--hency-gold, #c5a059);
    display: flex;
    height: 100%;
    justify-content: center;
    width: 100%;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__name {
    color: var(--hency-charcoal, #1a1a1a);
    font-family: var(--font-heading-family);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.25;
    margin: 2rem 0 0;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__link:hover .shop-by-category__image-wrap {
    transform: translateY(-5px);
    box-shadow: 0 10px 24px rgba(197, 160, 89, 0.25);
    border-color: var(--hency-gold-dark, #9f7d37);
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__link:hover .shop-by-category__image {
    transform: scale(1.04);
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__link:hover .shop-by-category__name {
    color: var(--hency-gold, #c5a059);
  }

  /* Navigation arrows */
  #ShopByCategory-{{ section.id }} .shop-by-category__nav {
    display: flex;
    justify-content: center;
    gap: 1.2rem;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__btn {
    width: 4.2rem;
    height: 4.2rem;
    border-radius: 50%;
    border: 1px solid var(--hency-border-subtle, rgba(197, 160, 89, 0.3));
    background: #ffffff;
    color: var(--hency-charcoal, #1a1a1a);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s ease;
    font-size: 1.8rem;
  }

  #ShopByCategory-{{ section.id }} .shop-by-category__btn:hover {
    background: var(--hency-gold, #c5a059);
    color: #ffffff;
    border-color: var(--hency-gold, #c5a059);
  }
{%- endstyle -%}

<section id="ShopByCategory-{{ section.id }}" class="shop-by-category color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="shop-by-category__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="shop-by-category__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="shop-by-category__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="shop-by-category__description rte">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        <a class="button button--secondary shop-by-category__button" style="margin-top: 2rem;" href="{{ section.settings.button_link | default: routes.collections_url }}">
          {{ section.settings.button_text | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="shop-by-category__slider-wrapper">
        <div class="shop-by-category__slider" id="CategorySlider-{{ section.id }}" role="region" aria-label="Categories carousel">
          {%- for block in section.blocks -%}
            {%- liquid
              assign collection = block.settings.collection
              assign title = block.settings.title
              if title == blank and collection != blank
                assign title = collection.title
              endif
              if title == blank
                assign title = 'Category'
              endif

              assign link = block.settings.link
              if link == blank and collection != blank
                assign link = collection.url
              endif
              if link == blank
                assign link = routes.all_products_collection_url
              endif

              assign image = block.settings.image
              if image == blank and block.settings.use_collection_image and collection.featured_image != blank
                assign image = collection.featured_image
              endif
            -%}
            <div class="shop-by-category__item" {{ block.shopify_attributes }}>
              <a class="shop-by-category__link" href="{{ link }}">
                <div class="shop-by-category__image-wrap">
                  {%- if image != blank -%}
                    {{
                      image
                      | image_url: width: 600
                      | image_tag:
                        class: 'shop-by-category__image',
                        loading: 'lazy',
                        widths: '160, 240, 360, 480, 600',
                        alt: title | escape
                    }}
                  {%- elsif collection.featured_image != blank -%}
                    {{
                      collection.featured_image
                      | image_url: width: 600
                      | image_tag:
                        class: 'shop-by-category__image',
                        loading: 'lazy',
                        widths: '160, 240, 360, 480, 600',
                        alt: title | escape
                    }}
                  {%- else -%}
                    <div class="shop-by-category__placeholder">{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                  {%- endif -%}
                </div>
                <h3 class="shop-by-category__name">{{ title | escape }}</h3>
              </a>
            </div>
          {%- endfor -%}
        </div>

        <div class="shop-by-category__nav" aria-label="Category carousel controls">
          <button
            class="shop-by-category__btn"
            type="button"
            aria-label="Previous categories"
            onclick="document.getElementById('CategorySlider-{{ section.id }}').scrollBy({ left: -260, behavior: 'smooth' })"
          >
            &#8592;
          </button>
          <button
            class="shop-by-category__btn"
            type="button"
            aria-label="Next categories"
            onclick="document.getElementById('CategorySlider-{{ section.id }}').scrollBy({ left: 260, behavior: 'smooth' })"
          >
            &#8594;
          </button>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop By Category",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DISCOVER BY CATEGORY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop By Category"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View All Categories"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Block",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Category Image (optional)"
        },
        {
          "type": "checkbox",
          "id": "use_collection_image",
          "label": "Fallback to collection image if custom image empty",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override (optional)",
          "info": "Leave blank to use the collection's name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override (optional)",
          "info": "Leave blank to link directly to the selected collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Category",
      "blocks": [
        { "type": "category", "settings": { "title": "Bangles" } },
        { "type": "category", "settings": { "title": "Mangalsutra" } },
        { "type": "category", "settings": { "title": "Earrings" } },
        { "type": "category", "settings": { "title": "Gold Chains" } },
        { "type": "category", "settings": { "title": "Rings" } },
        { "type": "category", "settings": { "title": "Payal" } },
        { "type": "category", "settings": { "title": "Necklaces" } }
      ]
    }
  ]
}
{% endschema %}
