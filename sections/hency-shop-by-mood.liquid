{%- style -%}
  #ShopByMood-{{ section.id }} {
    background-color: var(--hency-cream, #f6f3ed);
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #ShopByMood-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__header {
    text-align: center;
    max-width: 70rem;
    margin: 0 auto 3.5rem;
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__eyebrow {
    color: var(--hency-gold, #c5a059);
    font-size: 1.2rem;
    letter-spacing: 0.25rem;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 0.8rem;
    display: block;
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__title {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 3.5vw, 3.8rem);
    line-height: 1.2;
    margin: 0;
    font-weight: var(--font-heading-weight, 500);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__description {
    color: rgba(26, 26, 26, 0.75);
    margin: 1.2rem auto 0;
    font-size: 1.5rem;
    line-height: 1.5;
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media screen and (min-width: 990px) {
    #ShopByMood-{{ section.id }} .shop-by-mood__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
      gap: 2.4rem;
    }
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__card {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    border: 1px solid var(--hency-border-subtle, rgba(197, 160, 89, 0.2));
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__card:hover .shop-by-mood__image {
    transform: scale(1.06);
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.65) 100%);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__card:hover .shop-by-mood__overlay {
    opacity: 0.85;
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 2.4rem 1.8rem;
    box-sizing: border-box;
    color: #ffffff;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__card-title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.8rem, 2.2vw, 2.4rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
    font-weight: 500;
    color: #ffffff;
    line-height: 1.2;
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__card-description {
    font-size: 1.3rem;
    margin: 0.6rem 0 0;
    opacity: 0.9;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__card-link-text {
    margin-top: 1.2rem;
    font-size: 1.2rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--hency-gold-light, #e0c890);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: gap 0.2s ease;
  }

  #ShopByMood-{{ section.id }} .shop-by-mood__card:hover .shop-by-mood__card-link-text {
    gap: 0.8rem;
  }
{%- endstyle -%}

<section id="ShopByMood-{{ section.id }}" class="shop-by-mood color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="shop-by-mood__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="shop-by-mood__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="shop-by-mood__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="shop-by-mood__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="shop-by-mood__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign collection = block.settings.collection
            assign title = block.settings.title
            if title == blank and collection != blank
              assign title = collection.title
            endif
            if title == blank
              assign title = 'Mood'
            endif

            assign link = block.settings.link
            if link == blank and collection != blank
              assign link = collection.url
            endif
            if link == blank
              assign link = routes.all_products_collection_url
            endif

            assign image = block.settings.image
            if image == blank and collection.featured_image != blank
              assign image = collection.featured_image
            endif
          -%}
          <div class="shop-by-mood__card" {{ block.shopify_attributes }}>
            <a href="{{ link }}" class="shop-by-mood__card-link full-unstyled-link" aria-label="{{ title | escape }}">
              <div class="shop-by-mood__media">
                {%- if image != blank -%}
                  {{
                    image
                    | image_url: width: 800
                    | image_tag:
                      class: 'shop-by-mood__image',
                      loading: 'lazy',
                      widths: '300, 450, 600, 800',
                      alt: title | escape
                  }}
                {%- else -%}
                  {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg shop-by-mood__image' }}
                {%- endif -%}
              </div>
              <div class="shop-by-mood__overlay" style="opacity: {{ block.settings.overlay_opacity | default: 60 | divided_by: 100.0 }};"></div>
              <div class="shop-by-mood__content">
                <h3 class="shop-by-mood__card-title">{{ title | escape }}</h3>
                {%- if block.settings.description != blank -%}
                  <p class="shop-by-mood__card-description">{{ block.settings.description | escape }}</p>
                {%- endif -%}
                <span class="shop-by-mood__card-link-text">Explore &rarr;</span>
              </div>
            </a>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop By Mood",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag",
      "default": "CURATED EXPERIENCES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section heading",
      "default": "Shop By Mood"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover jewels thoughtfully composed for every mood, sentiment and milestone.</p>"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop columns",
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "mood",
      "name": "Mood Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Mood Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Mood Title",
          "default": "EVERYDAY"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short subtitle",
          "default": "Effortless, understated sparkle"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link override (optional)"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 20,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "Overlay opacity",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Mood",
      "blocks": [
        {
          "type": "mood",
          "settings": {
            "title": "EVERYDAY",
            "description": "Minimal silhouettes for daily grace"
          }
        },
        {
          "type": "mood",
          "settings": {
            "title": "FESTIVE",
            "description": "Radiant sparkle for cultural grandeur"
          }
        },
        {
          "type": "mood",
          "settings": {
            "title": "WEDDING",
            "description": "Royal heirloom-inspired bridal magnificence"
          }
        },
        {
          "type": "mood",
          "settings": {
            "title": "GIFTING",
            "description": "Unforgettable expressions of love"
          }
        }
      ]
    }
  ]
}
{% endschema %}
