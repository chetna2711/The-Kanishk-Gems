    "faq_section": {
      "type": "hency-faq",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "What materials and craftsmanship are used in HencyJewels pieces?",
            "answer": "<p>Our jewellery is crafted using skin-safe, hypoallergenic brass and copper alloys, coated with durable micro-gold plating and adorned with precision-cut stones, simulated uncut diamonds and genuine Kundan work.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "How should I care for my jewellery to maintain its shine?",
            "answer": "<p>Store your jewellery in airtight zip pouches away from moisture, perfumes and harsh sprays. Wipe gently with a dry lint-free cloth after each wear.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "How long does shipping take across India?",
            "answer": "<p>Orders are dispatched within 24-48 hours. Delivery takes 3-5 business days for major metropolitan areas and 5-7 business days for other regions.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "What is your exchange and return policy?",
            "answer": "<p>We offer a hassle-free 15-day exchange policy for all unworn items retained in their original packaging and security tags.</p>"
          }
        }
      },
      "block_order": [
        "faq_1",
        "faq_2",
        "faq_3",
        "faq_4"
      ],
